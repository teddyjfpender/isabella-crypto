{
  "name": "isabella-tests",
  "version": "1.0.0",
  "description": "Cross-validation tests for Isabella against noble-post-quantum",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:kyber": "bun test kyber",
    "test:ntt": "bun test ntt",
    "test:lazer": "bun test lazer-comparison",
    "validate-sdks": "bun run validate-ocaml && bun run validate-haskell",
    "audit-confidential": "bun build ./src/audit-confidential-transaction.ts --target=node --outfile=/tmp/isabella-audit-confidential.mjs && ISABELLA_PROJECT_ROOT=.. node /tmp/isabella-audit-confidential.mjs",
    "generate-vectors": "bun src/generate-vectors.ts",
    "validate-haskell": "bun build ./src/validate-haskell.ts --target=node --outfile=/tmp/isabella-validate-haskell.mjs && ISABELLA_PROJECT_ROOT=.. node /tmp/isabella-validate-haskell.mjs",
    "validate-ocaml": "bun build ./src/validate-ocaml.ts --target=node --outfile=/tmp/isabella-validate-ocaml.mjs && ISABELLA_PROJECT_ROOT=.. node /tmp/isabella-validate-ocaml.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.2.0"
  }
}
